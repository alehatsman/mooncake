[Unit]
Description=Mooncake host daemon (agentd, user-scope)
Documentation=https://github.com/alehatsman/mooncake
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %h expands to $HOME of the owning user — works under `systemctl --user`
# and avoids baking an absolute /home/<user>/... path into the unit so
# the same template renders identically across machines.
ExecStart=%h/.local/bin/mooncake agentd run --bind 0.0.0.0:{{PORT}}
# PATH= prepends %h/.local/bin so shell-action steps can call
# user-installed binaries (claude, mcsearch, language toolchains
# pinned via mise/asdf/etc.) without the step having to hardcode
# the full path. systemd's default user-unit PATH omits %h/.local/bin,
# and shell actions invoke `bash -c <cmd>` non-interactively — bash
# doesn't source ~/.bashrc in that mode, so PATH stays whatever the
# parent passes. The system unit doesn't need this: root's default
# PATH covers /usr/local/bin and root doesn't have a per-user bin.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Restart=always parity with the system unit: clean exits (self-upgrade
# exec, SIGTERM during deploy, controller-side race) still get the daemon
# back. RestartSec=5 + default StartLimitInterval bound any boot loop.
Restart=always
RestartSec=5
# No User=/Group= — user units run as the owning user automatically.
# No ProtectSystem/ReadWritePaths hardening — the user already owns
# their ~/.local/bin (where `fleet upgrade` swaps the binary) and
# can't write system paths anyway, so the system-unit's ReadWritePaths
# hole isn't needed.
#
# No NoNewPrivileges= either: the user-mode agentd's whole purpose for
# `as_user: root` steps is to escalate via sudo (a setuid binary), and
# NoNewPrivileges=true blocks setuid execution outright — sudo refuses
# with "The 'no new privileges' flag is set, which prevents sudo from
# running as root" regardless of NOPASSWD. The system unit can keep
# NNP because root never needs to escalate; user-mode must drop it.

[Install]
WantedBy=default.target
