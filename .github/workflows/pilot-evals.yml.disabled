---
# Mooncake pilot eval harness — spec-67 §14.
#
# Triggers on PRs labeled `needs-pilot-eval`. Real LLM calls cost
# real money, so this workflow is opt-in via label, not auto-run
# on every push.
#
# Currently `.disabled` to match the project's other workflow files;
# rename to `.yml` and set repo secrets (CLAUDE_API_KEY) to enable.

name: Pilot Evals

on:
  pull_request:
    types: [labeled, synchronize]

env:
  GO_VERSION: '1.26.3'

jobs:
  dry-run:
    # Shape check on every PR — cheap, no API calls. Catches goal/snapshot/
    # assertion regressions before someone pays for a labeled run.
    name: Harness shape (dry-run)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: ${{ env.GO_VERSION }}
      - name: Dry-run harness
        run: task pilot-evals-dry

  paid-run:
    # Real LLM-backed sweep. Only runs when the `needs-pilot-eval` label
    # is on the PR. Gated separately from dry-run so a typo in a goal file
    # cannot silently burn tokens.
    name: Pilot evals (labeled)
    needs: dry-run
    if: contains(github.event.pull_request.labels.*.name, 'needs-pilot-eval')
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: ${{ env.GO_VERSION }}
      - name: Run pilot evals
        env:
          MOONCAKE_PILOT_EVAL: '1'
          CLAUDE_API_KEY: ${{ secrets.CLAUDE_API_KEY }}
        run: task pilot-evals
